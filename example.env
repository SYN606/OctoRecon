# ==========================================
# OctoRecon V2 - Environment Configuration
# ==========================================
# Instructions: 
# 1. Copy this file and rename it to ".env"
# 2. Replace the placeholder values with your actual API keys.
# 3. DO NOT commit the ".env" file to version control.

# --- Core Scanner Configuration ---
# HTTP Timeout in seconds (Increase for slow networks)
OCTORECON_TIMEOUT=15
# Maximum concurrent HTTP requests (Protect against socket exhaustion)
OCTORECON_MAX_CONCURRENT=50
# User-Agent string to identify the scanner
OCTORECON_USER_AGENT="OctoRecon-Modern/2.0"

# --- OSINT API Keys ---
# Used for subdomain enumeration and intelligence gathering

# AlienVault OTX (Prevents 429 Rate Limit errors)
# Get a key at: https://otx.alienvault.com/
ALIENVAULT_API_KEY=your_alienvault_api_key_here

# SecurityTrails
# Get a key at: https://securitytrails.com/
SECURITYTRAILS_API_KEY=your_securitytrails_api_key_here

# VirusTotal
# Get a key at: https://www.virustotal.com/
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here

# Shodan (Used for IP and port recon)
# Get a key at: https://developer.shodan.io/
SHODAN_API_KEY=your_shodan_api_key_here

# GitHub (Used for finding secrets and leaked repos)
# Get a Personal Access Token at: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_personal_access_token_here
