# ==========================================
# 🐙 OctoRecon V2 - Environment Configuration
# ==========================================
# Instructions:
# 1. Copy this file and rename it to ".env":
#    Linux/Mac: cp example.env .env
#    Windows:   Copy-Item example.env .env
# 2. Configure any desired custom settings or API keys below.
# 3. DO NOT commit your ".env" file to Git.

# --- Core Scanner & HTTP Engine ---
# HTTP Request Timeout in seconds (default: 15)
OCTORECON_TIMEOUT=15

# Maximum concurrent HTTP requests (protects against socket exhaustion, default: 50)
OCTORECON_MAX_CONCURRENT=50

# Custom User-Agent header
OCTORECON_USER_AGENT="OctoRecon-Modern/2.0"

# SSL Certificate verification (True / False, default: True)
OCTORECON_VERIFY_SSL=True

# Follow HTTP redirects (True / False, default: True)
OCTORECON_FOLLOW_REDIRECTS=True

# --- Database Storage ---
# Custom SQLite database location (default: database/octorecon.db)
# OCTORECON_DB_PATH="database/octorecon.db"

# --- Web Dashboard Server ---
# Local interface to bind (default: 127.0.0.1)
OCTORECON_HOST="127.0.0.1"

# Web dashboard port (default: 8000)
OCTORECON_PORT=8000

# --- OSINT & Reconnaissance API Keys (V2 Active) ---
# All keys below are OPTIONAL. The framework runs completely without them,
# but providing keys unlocks deep queries and prevents public rate-limiting.

# 1. Shodan API Key (Required for 'shodan' module: open ports, banners, known CVEs)
# Get a key at: https://developer.shodan.io/
SHODAN_API_KEY=

# 2. IPInfo.io Token (Extends daily quota for 'ipinfo' server location & ASN lookup)
# Get a free token at: https://ipinfo.io/signup
IPINFO_TOKEN=

# 3. AlienVault OTX API Key (Used in 'subdomains' module to bypass anonymous 429 limits)
# Get a free key at: https://otx.alienvault.com/
ALIENVAULT_API_KEY=

# 4. URLScan API Key (Used in 'subdomains' module for passive domain history search)
# Get a free key at: https://urlscan.io/user/signup
URLSCAN_API_KEY=
